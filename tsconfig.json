{
	"include": ["src/**/*.ts"],
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"isolatedModules": true,
		"lib": ["esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": false,
		"strict": true,
		"target": "esnext"
	}
}
